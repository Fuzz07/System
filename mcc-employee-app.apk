<?php
// db_connect.php
$host = "127.0.0.1";
$db   = "u510162695_drSancho";
$user = "u510162695_DrSancho2026";
$pass = "@DoctorSancho2026";
$charset = "utf8mb4";

$dsn = "mysql:host=$host;dbname=$db;charset=$charset";
$options = [
    PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
    PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
];

try {
    $pdo = new PDO($dsn, $user, $pass, $options);
} catch (\PDOException $e) {
    die("Database connection failed: " . $e->getMessage());
}

// create_admin.php
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $username  = $_POST['username'] ?? null;
    $email     = $_POST['email'] ?? null;
    $full_name = $_POST['full_name'] ?? null;
    $password  = $_POST['password'] ?? null;

    if ($username && $email && $full_name && $password) {
        // Securely hash the password
        $hashedPassword = password_hash($password, PASSWORD_BCRYPT);

        $sql = "INSERT INTO admin (username, email, full_name, password, role, last_login, created_at)
                VALUES (:admin1, :admin@gmail.com, :full_name, :password123, 'admin', NULL, NOW())";

        $stmt = $pdo->prepare($sql);
        $stmt->execute([
            ':username'  => $username,
            ':email'     => $email,
            ':full_name' => $full_name,
            ':password'  => $hashedPassword,
        ]);

        echo "Admin user created successfully!";
    } else {
        echo "Please provide username, email, full name, and password.";
    }
}
?>
